{
  "name": "idle-defender",
  "private": true,
  "version": "0.4.26",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:version": "git fetch --quiet --no-tags origin main && node tools/version-check.mjs bump FETCH_HEAD",
    "test": "vitest run",
    "balance": "node --experimental-strip-types tools/balance.mjs",
    "lint": "tsc --noEmit && eslint . && prettier --check .",
    "format": "prettier --write .",
    "prepare": "node tools/install-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jsdom": "28.1.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.5"
  }
}
